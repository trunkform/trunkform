# trunkform configuration
version: 0.1.0
tools:
- jest
- GitHub Actions
steering: strict
related:
- ../.github/workflows/*
- ./**/cfn.test.js
rubric:
  perf-test-implemented: true
  unit-test-implemented: true
  ci-cd-automation-boilerplate: true
  continuous-integration-iac: true
  continuous-integration-test-double-implemented: true
  continuous-integration-mocks-implemented: true
  integration-test-implemented: true
